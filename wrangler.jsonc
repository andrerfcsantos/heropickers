{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heropickers",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  // Workers Previews: one Preview per branch / pull request under this same
  // Worker. The site is static assets only, so there are no bindings or vars
  // to point elsewhere and the block stays empty, but Previews require it to
  // exist. Preview URLs are public unless access controls are set up.
  "previews": {},
}
