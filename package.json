{
  "name": "heropickers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt \"src/**/*.{ts,css}\" \"*.html\" \"scripts/**/*.mts\"",
    "generate-og": "node scripts/generate-og.mts",
    "deploy": "vp build && wrangler deploy",
    "upload": "vp build && wrangler versions upload",
    "deploy:preview": "vp build && wrangler preview",
    "deps:check": "node scripts/deps.mts",
    "deps:update": "vp update && node scripts/deps.mts",
    "deps:update:major": "vp update --latest --interactive && node scripts/deps.mts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.13.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "npm@11.12.0",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
